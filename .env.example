# 复制本文件为 .env（放在仓库根目录），填入你的凭据。
# .env 已被 .gitignore 忽略，不会被提交。

THU_USER_ID=你的学号
THU_PASSWORD=你的密码

# 可选：抓取下学期课表（nextSemesterList 下标，0 起）。留空 = 当前学期。
# THU_SEMESTER_INDEX=

# 可选：输出路径，默认 res/coursesAuto.ics（相对于运行目录）。
# THU_OUTPUT=res/coursesAuto.ics

# 可选：日历名称，默认「清华大学课表（学期名）」。
# THU_CALNAME=

# 可选：设备指纹（32 位十六进制）。默认按学号与本机名稳定生成。
# THU_FINGERPRINT=

# 可选：HTTP 代理。清华域名应保持直连。
# HTTPS_PROXY=http://127.0.0.1:15236

# 可选：保存原始接口数据 / 离线重新生成（dump/ 已被 .gitignore 忽略）。
# THU_DUMP_DIR=dump
# THU_OFFLINE=dump

# 注意：
# 1. 文件请保存为 UTF-8（无 BOM 或有 BOM 均可）。
# 2. 密码中包含 # 等字符时无需转义，整行等号后的内容都会作为值。
# 3. 若账号启用了 TOTP 两步验证，运行时会提示手动输入 6 位验证码，
#    不需要在此保存 TOTP 密钥。
