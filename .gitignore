# ---------------------------------------------------------------------------
# thu-courses-ics (.gitignore)
#
# 只提交源码、脚本与文档；构建产物、个人凭据、抓取到的课表数据都不入库。
# 检查规则是否误伤已跟踪文件：git ls-files -i -c --exclude-standard
# ---------------------------------------------------------------------------

# ---------- 构建目录（CMake / 各种生成器） ----------
/build/
/out/
/cmake-build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
build.ninja
.ninja_deps
.ninja_log
compile_commands.json
Makefile
*.make
CMakeScripts/

# ---------- 编译产物与中间文件（MinGW / MSVC） ----------
*.exe
*.dll
*.lib
*.a
*.o
*.obj
*.pdb
*.ilk
*.exp
*.idb
*.res
*.gch
*.pch
*.d
*.obj.d
*.stackdump

# ---------- 本地凭据（.env.example 是模板，必须提交） ----------
.env
.env.local
.env.*.local
!.env.example

# 批量生成的账号列表（明文密码，绝不能提交）
/accounts.txt
/accounts*.txt
/students.txt

# 学号 → 代号的盐（泄露后代号可被反查，绝不能提交）
/.id-salt

# 含学号的本地对照表（默认落在 res\ 里，这里兜底）
/id-map.txt

# 本地地点映射（由 locations.example.csv 复制而来）
/locations.csv

# 未匹配地点清单（一般落在 res\ 里，这里兜底）
/unmatched-locations.txt

# ---------- 个人数据：抓取的原始接口数据与生成的课表 ----------
/dump/
/res/
*.ics

# ---------- 编辑器 / IDE ----------
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates
*.code-workspace

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.bak
*.orig
*.rej
*.swp
*~

# ---------- 操作系统 ----------
Thumbs.db
desktop.ini
.DS_Store
